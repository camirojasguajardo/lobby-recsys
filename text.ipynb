    "\n",
    "# Buscar y ordenar los archivos .npy\n",
    "archivos_detalle = sorted(glob.glob(os.path.join(ruta, \"emb_detalle_*.npy\")))\n",
    "\n",
    "print(f\"Archivos encontrados: {len(archivos_detalle)}\")\n",
    "\n",
    "# Unir todos los embeddings\n",
    "emb_detalle = np.concatenate([np.load(f) for f in archivos_detalle])\n",
    "\n",
    "print(\"Tamaño final de emb_detalle:\", emb_detalle.shape)\n",
    "\n",
    "# Guardar el archivo combinado\n",
    "np.save(os.path.join(ruta, \"emb_detalle_full.npy\"), emb_detalle)\n",
    "\n",
    "print(\"Archivo final guardado en:\")\n",
    "print(os.path.join(ruta, \"emb_detalle_full.npy\"))\n"
